# BEYİN: API anahtarı GEREKMEZ. Bilgisayarda Claude Code kuruluysa (bir kere "claude" yazıp hesabınla girdiysen)
# yardımcı onunla düşünür. İstersen API anahtarı da yazabilirsin; o zaman onu kullanır.
ANTHROPIC_API_KEY=
# Zorlamak için: claude | api | basit  (boş = kendisi seçer)
YZ_BEYIN=

# X-RAY: otomatik = kendi tek kişilik dünyanda açık, sunucuda ya da başka oyuncu varken kapalı. (acik | kapali da yazılabilir)
XRAY=otomatik

# KOMUT (Java): otomatik = hileler açıksa yapıları /setblock ile kat kat kurar (malzemesiz), kapalıysa malzeme toplayıp
# gerçekçi kurar. acik | kapali da yazılabilir. KOMUT_HIZ_MS: komutla inşada iki blok arası bekleme (ms).
KOMUT=otomatik
KOMUT_HIZ_MS=120

# ---- Java Edition botu ----
MC_HOST=localhost
# "LAN'a aç" deyince oyunun yazdığı port (ör. 51234) ya da sunucu portu (25565)
MC_PORT=25565
BOT_ADI=Yardimci
# offline: LAN / online-mode=false sunucu. microsoft: bot için ayrı bir Minecraft hesabı
MC_AUTH=offline
# Boş bırakırsan sürümü kendisi bulur (ör. 1.21.4)
MC_SURUM=
# Sadece bu oyuncunun komutlarını dinlesin (Minecraft kullanıcı adın). Boş: kendi dünyanda herkes,
# sunucuda ise adımı (BOT_ADI) ilk söyleyen oyuncu.
SAHIP=

# ---- Bedrock köprüsü ----
KOPRU_PORT=3000
