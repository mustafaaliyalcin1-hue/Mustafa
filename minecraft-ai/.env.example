# Claude API anahtarı (https://console.anthropic.com → API Keys). Boş bırakırsan basit komut modunda çalışır.
ANTHROPIC_API_KEY=

# ---- Java Edition botu ----
MC_HOST=localhost
# "LAN'a aç" deyince oyunun yazdığı port (ör. 51234) ya da sunucu portu (25565)
MC_PORT=25565
BOT_ADI=Yardimci
# offline: LAN / online-mode=false sunucu. microsoft: bot için ayrı bir Minecraft hesabı
MC_AUTH=offline
# Boş bırakırsan sürümü kendisi bulur (ör. 1.21.4)
MC_SURUM=
# Sadece bu oyuncunun komutlarını dinlesin (Minecraft kullanıcı adın). Boş = herkes
SAHIP=

# ---- Bedrock köprüsü ----
KOPRU_PORT=3000
