# ============================================================
# J.A.R.V.I.S. — backend ortam değişkenleri (2. aşamadan itibaren kullanılır)
# Bu dosyayı ".env" adıyla kopyalayıp doldurun. .env ASLA git'e girmez,
# anahtarlar ASLA frontend koduna konmaz; hepsi yalnızca backend'de durur.
# ============================================================

# --- Yapay zekâ beyni (zorunlu) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Ses ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Wake word "Jarvis" için (isteğe bağlı; yoksa Web Speech API kullanılır)
PICOVOICE_ACCESS_KEY=
# Whisper yedeği (isteğe bağlı)
OPENAI_API_KEY=

# --- Araştırma (Claude web search birincil; bunlar yedek) ---
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# --- Hava durumu (Open-Meteo anahtarsız çalışır; OpenWeather isteğe bağlı) ---
OPENWEATHER_API_KEY=
DEFAULT_CITY=İstanbul

# --- Spor / finans / harita ---
FOOTBALL_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- Home Assistant ---
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# --- Firebase (Firestore hafıza) ---
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# --- Güvenlik ---
# Uygulamanın backend'e bağlanırken kullandığı gizli anahtar
JARVIS_APP_SECRET=
PORT=8787
TZ=Europe/Istanbul
