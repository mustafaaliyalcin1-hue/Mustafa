# ============================================================
# J.A.R.V.I.S. — backend ortam değişkenleri (2. aşamadan itibaren kullanılır)
# Bu dosyayı ".env" adıyla kopyalayıp doldurun. .env ASLA git'e girmez,
# anahtarlar ASLA frontend koduna konmaz; hepsi yalnızca backend'de durur.
# ============================================================

# --- Yapay zekâ beyni (en az biri zorunlu) ---
# ÜCRETSİZ: Google Gemini — aistudio.google.com → "Get API key" (kart gerekmez)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# ÜCRETSİZ yedekler (biri kotayı doldurunca sıradakine geçilir; sıra: BRAIN_ORDER)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
# Kendi bilgisayarında çalışan yerel model (Ollama). Sunucu aynı bilgisayardaysa: http://localhost:11434/v1
OLLAMA_URL=
OLLAMA_MODEL=qwen3:8b
BRAIN_ORDER=gemini,groq,openrouter,ollama
# İsteğe bağlı, ücretli: Claude. İkisi de doluysa Gemini kullanılır; AI_PROVIDER=claude ile Claude'a geçilir.
AI_PROVIDER=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# low = en hızlı, medium = dengeli (önerilen), high = en titiz
CLAUDE_EFFORT=medium

# --- Ses ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Wake word "Jarvis" için (isteğe bağlı; yoksa Web Speech API kullanılır)
PICOVOICE_ACCESS_KEY=
# Whisper yedeği (isteğe bağlı)
OPENAI_API_KEY=

# --- Araştırma (Claude web search birincil; bunlar yedek) ---
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# --- Hava durumu (Open-Meteo anahtarsız çalışır; OpenWeather isteğe bağlı) ---
OPENWEATHER_API_KEY=
DEFAULT_CITY=İstanbul

# --- Spor / finans / harita ---
FOOTBALL_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- Roborock (doğrudan Roborock hesabı; Home Assistant gerekmez) ---
ROBOROCK_EMAIL=

# --- WhatsApp (Meta WhatsApp Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Yalnızca bu numaradan gelen mesajlar kabul edilir (ör. 905xxxxxxxxx)
WHATSAPP_ALLOWED_NUMBER=

# --- Home Assistant (şimdilik kullanılmıyor; ileride eklenebilir) ---
HA_URL=
HA_TOKEN=

# --- Firebase (Firestore hafıza) ---
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# --- Güvenlik ---
# Uygulamanın backend'e bağlanırken kullandığı gizli anahtar
JARVIS_APP_SECRET=
# Arayüzün açıldığı adresler (virgülle). Boşsa her yerden izin verilir.
ALLOWED_ORIGINS=https://PROJE-ADI.web.app,http://localhost:5173
PORT=8787
TZ=Europe/Istanbul
