# Bu dosyayı ".env" adıyla kopyalayıp YEREL denemede kullanın. .env depoya girmez (.gitignore).
# Bulutta (Render/Railway/Fly) bu değerler panelin "Environment / Variables / Secrets" bölümüne girilir.

# Arayüzün sunucuya bağlanma şifresi (uygulamada "Uygulama anahtarı" olarak girilir)
JARVIS_APP_SECRET=uzun-rastgele-bir-sifre

# KARMA BEYİN — bilgisayar köprüsünün şifresi (köprüde de aynısı girilir)
KOPRU_SIFRESI=baska-uzun-rastgele-bir-sifre
# Bilgisayar kapalıyken kullanılacak Claude API anahtarı
ANTHROPIC_API_KEY=
# İsteğe bağlı: CLAUDE_MODEL=claude-sonnet-5-5 · KARMA_EFFORT=low · AI_PROVIDER=karma|free|claude

# İsteğe bağlı ücretsiz beyin (Claude API anahtarı yoksa yedek olarak kullanılır)
GEMINI_API_KEY=

DEFAULT_CITY=Elazığ
TZ=Europe/Istanbul
